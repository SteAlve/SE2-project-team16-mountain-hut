{
  "name": "mountain-hut-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "db:create": "node scripts/create.js",
    "db:drop": "node scripts/drop.js",
    "db:migrate": "node scripts/migrate.js",
    "db:reset": "npm run db:drop && npm run db:migrate",
    "db:seed": "node scripts/seed.js",
    "dev": "node --watch src/index.js",
    "lint": "eslint .",
    "start": "node src/index.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --dir test"
  },
  "dependencies": {
    "express": "^5.3.0",
    "nodemailer": "^10.3.1",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "supertest": "^7.3.1",
    "vitest": "^5.0.5"
  }
}
