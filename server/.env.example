# Copy this file to server/.env and edit the values. server/.env is personal: it is never committed.
# A variable already set in the environment (IDE run configuration, CI, Docker) wins over this file.

# The database of the server (npm start, npm run db:migrate, npm run db:seed ...)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mountain_hut

# The database of the tests (used when NODE_ENV=test, which vitest sets by itself).
# Use a different database: the tests delete data.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mountain_hut_test

# Optional, with their default:
# PORT=3001
# SESSION_TTL_HOURS=24
# COOKIE_SECURE=false
